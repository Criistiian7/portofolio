rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnedByCurrentUser(data) {
      return data.ownerId is string && data.ownerId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow create: if isSignedIn() && isOwnedByCurrentUser(request.resource.data);

      allow read, delete: if isSignedIn() && isOwnedByCurrentUser(resource.data);

      allow update: if isSignedIn()
        && isOwnedByCurrentUser(resource.data)
        && isOwnedByCurrentUser(request.resource.data);
    }
  }
}
