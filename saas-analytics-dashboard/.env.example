# Mock mode: set VITE_ENABLE_MOCK=true for local demo without Firebase.
# If VITE_ENABLE_MOCK is unset and Firebase keys below are empty, the app auto-enables mock mode.
# Set VITE_ENABLE_MOCK=false only when every VITE_FIREBASE_* value is filled.
VITE_ENABLE_MOCK=

# Firebase (required when VITE_ENABLE_MOCK=false and all keys are set)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
